{
  "name": "watdatmean",
  "displayName": "WatDatMean — Learn in Your Code",
  "description": "Understand code, explore examples, and preview edits in TypeScript, JavaScript, Python, and other languages.",
  "version": "0.1.27",
  "publisher": "watdatmean",
  "repository": {
    "type": "git",
    "url": "https://github.com/geckobees/watdatmean.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "learn",
    "typescript",
    "explain",
    "beginner",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:csharp",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:swift",
    "onLanguage:sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Local explanations work; AI requests, edits, and Java runtime checks require a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "watdatmean.checkJavaRuntime",
        "title": "WatDatMean: Check Java Setup"
      },
      {
        "command": "watdatmean.restoreJavaRuntime",
        "title": "WatDatMean: Restore Previous Java Setup"
      },
      {
        "command": "watdatmean.inspect",
        "title": "WatDatMean: Explain Selection or Code at Cursor"
      },
      {
        "command": "watdatmean.reopenPanel",
        "title": "WatDatMean: Reopen Learning Panel"
      },
      {
        "command": "watdatmean.configure",
        "title": "WatDatMean: Configure AI Provider / API Key"
      },
      {
        "command": "watdatmean.removeKey",
        "title": "WatDatMean: Remove API Key"
      },
      {
        "command": "watdatmean.clearCache",
        "title": "WatDatMean: Clear Explanation Cache"
      },
      {
        "command": "watdatmean.demo",
        "title": "WatDatMean: Open Demo Project"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "watdatmean.inspect",
          "when": "resourceScheme != watdatmean",
          "group": "navigation@10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "watdatmean.inspect",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && resourceScheme != watdatmean"
      }
    ],
    "configuration": {
      "title": "WatDatMean",
      "properties": {
        "watdatmean.autoConfigureJavaRuntime": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Check Oracle Java's server runtime in trusted workspaces. Keep compatible older JDKs; use a verified installed JDK when the server path is missing or incompatible, preserving the project JDK. Does not change shared workspace settings or download a JDK automatically."
        },
        "watdatmean.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "groq"
          ],
          "default": "openai",
          "scope": "application",
          "description": "Provider used for on-demand explanations. Configure the API key with the WatDatMean command."
        },
        "watdatmean.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional model ID override for the selected provider. Leave blank for the default."
        },
        "watdatmean.audience": {
          "type": "string",
          "enum": [
            "beginner",
            "experienced"
          ],
          "default": "beginner",
          "description": "Adjust explanation vocabulary and focus."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/setup-intellij.mjs",
    "setup:intellij": "node scripts/setup-intellij.mjs",
    "gradle:intellij": "node scripts/gradle-intellij.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:stress": "node scripts/stress-test.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test:ui": "node scripts/build-intellij.mjs && playwright test",
    "test:integration": "node scripts/integration.mjs",
    "test:gradle-import": "node scripts/test-gradle-import.mjs",
    "build:intellij": "node scripts/build-intellij.mjs",
    "package:intellij": "node scripts/package-intellij.mjs",
    "test:intellij": "node scripts/test-intellij.mjs"
  },
  "dependencies": {
    "@lezer/java": "1.1.5",
    "@lezer/python": "1.1.19",
    "jsonc-parser": "3.3.1",
    "parse5": "8.1.1",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
