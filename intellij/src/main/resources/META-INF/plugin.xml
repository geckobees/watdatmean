<idea-plugin>
  <id>com.watdatmean.intellij</id>
  <name>WatDatMean — Learn in Your Code</name>
  <version>0.1.8</version>
  <vendor url="https://github.com/geckobees/watdatmean">WatDatMean</vendor>
  <description><![CDATA[
    Understand selected code, explore examples, and preview edits in IntelliJ IDEA.
    Uses the same learning engine as the VS Code extension. Automatically sets up Node.js 22.12+
    and uses the bundled JetBrains Runtime with JCEF. AI help is opt-in with your own
    OpenAI, Anthropic, or Groq API key. Offline breakdowns support Java, TypeScript,
    JavaScript, JSX, and Python. Optional step-by-step lessons use the same panel in both editors.
  ]]></description>
  <idea-version since-build="223" until-build="252.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="WatDatMean" anchor="right" factoryClass="com.watdatmean.intellij.LearningToolWindow"/>
    <lang.documentationProvider language="JAVA" implementationClass="com.watdatmean.intellij.HoverDocumentation" order="first"/>
  </extensions>
  <actions>
    <action id="WatDatMean.Inspect" class="com.watdatmean.intellij.InspectAction"
            text="WatDatMean: Explain Selection or Code at Cursor"
            description="Understand code, explore examples, and preview an edit">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt E"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt E"/>
    </action>
    <action id="WatDatMean.ReopenPanel" class="com.watdatmean.intellij.ReopenPanelAction"
            text="WatDatMean: Reopen Learning Panel" description="Reload the panel using the latest version of its selected code">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="WatDatMean.Configure" class="com.watdatmean.intellij.ConfigureAction"
            text="WatDatMean: Configure AI Provider / Node.js">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="WatDatMean.RemoveKey" class="com.watdatmean.intellij.RemoveKeyAction"
            text="WatDatMean: Remove API Key"/>
    <action id="WatDatMean.ClearCache" class="com.watdatmean.intellij.ClearCacheAction"
            text="WatDatMean: Clear Explanation Cache"/>
    <action id="WatDatMean.Demo" class="com.watdatmean.intellij.DemoAction"
            text="WatDatMean: Open Java Demo" description="Explore the learning panel with a fresh editable Java scratch file">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
